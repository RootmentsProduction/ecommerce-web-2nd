# Server Configuration
PORT=7000
NODE_ENV=development

# Database Configuration (PostgreSQL connection string)
DATABASE_URL="postgresql://username:password@hostname:port/database_name?schema=public&sslmode=require"

# CORS Setup (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"

# JWT Configuration
JWT_SECRET="your_very_long_secure_jwt_secret_phrase"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# OTP Configuration
OTP_COOLDOWN_SECONDS=60
OTP_EXPIRY_MINUTES=15

# AWS Configuration (SES email delivery)
# Leave these commented out or blank to use the local development console/log fallback
# AWS_ACCESS_KEY_ID="your_aws_access_key"
# AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
# AWS_REGION="ap-southeast-2"
# AWS_SES_SENDER="no-reply@yourdomain.com"

# Cookie Configuration
COOKIE_SECURE=false # Set to true in staging/production
COOKIE_DOMAIN=localhost # Set to your domain in production

# AWS S3 Media Storage (images, videos, documents)
# Leave blank to fall back to local mock uploads in development
AWS_S3_BUCKET=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-southeast-2

# CloudFront CDN URL (no trailing slash)
# When set, all uploaded file URLs will use this domain instead of the direct S3 URL.
# Required when the S3 bucket is private (bucket policy blocks public access).
AWS_S3_CLOUDFRONT_URL=https://your-distribution-id.cloudfront.net
